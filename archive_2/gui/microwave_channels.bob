    <y>60</y>
    <width>390</width>
    <height>30</height>
    <text>UNH:GEN:MW:PS:VMEAS</text>
    <actions>
      <action type="write_pv">
        <pv_name>ca://$(P):HistoryPV</pv_name>
        <value>UNH:GEN:MW:PS:VMEAS</value>
      </action>
    </actions>
  </widget>
