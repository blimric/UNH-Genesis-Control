<?xml version='1.0' encoding='UTF-8'?>
<display version="2.0.0">
  <name>Archive History — Choose Channel</name>
  <width>1200</width>
  <height>1080</height>
  <macros>
    <P>UNH:GEN:ARCH</P>
    <INTERVAL>UNH:GEN:ARCH:SaveInterval</INTERVAL>
  </macros>
  <widget type="label" version="3.0.0">
    <name>Choose a channel, then return to Archiver and click Load / Refresh.</name>
    <x>20</x>
    <y>15</y>
    <width>1150</width>
    <height>28</height>
    <text>Choose a channel, then return to Archiver and click Load / Refresh.</text>
  </widget>
