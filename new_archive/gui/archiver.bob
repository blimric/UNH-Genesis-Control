<?xml version='1.0' encoding='UTF-8'?>
<display version="2.0.0">
  <name>Genesis Slow Controls Archiver</name>
  <width>1100</width>
  <height>790</height>
  <macros>
    <P>UNH:GEN:ARCH</P>
    <INTERVAL>UNH:GEN:ARCH:SaveInterval</INTERVAL>
  </macros>
  <widget type="label" version="3.0.0">
    <name>UNH Genesis — Slow Controls Archiver</name>
    <x>25</x>
    <y>18</y>
    <width>1000</width>
    <height>35</height>
    <text>UNH Genesis — Slow Controls Archiver</text>
  </widget>
  <widget type="label" version="3.0.0">
    <name>Seconds between saves</name>
    <x>25</x>
    <y>75</y>
    <width>210</width>
    <height>28</height>
    <text>Seconds between saves</text>
  </widget>
  <widget type="textentry" version="3.0.0">
    <name>SaveInterval</name>
    <x>240</x>
    <y>73</y>
    <width>130</width>
    <height>30</height>
    <pv_name>ca://$(INTERVAL)</pv_name>
    <precision>3</precision>
  </widget>
  <widget type="label" version="3.0.0">
    <name>Enter a positive value; changes apply immediately. Default: 1 s.</name>
    <x>395</x>
    <y>76</y>
    <width>680</width>
    <height>28</height>
    <text>Enter a positive value; changes apply immediately. Default: 1 s.</text>
  </widget>
  <widget type="label" version="3.0.0">
    <name>CSV history</name>
    <x>25</x>
    <y>135</y>
    <width>800</width>
    <height>28</height>
    <text>CSV history</text>
  </widget>
  <widget type="label" version="3.0.0">
    <name>Channel</name>
    <x>25</x>
    <y>180</y>
    <width>90</width>
    <height>28</height>
    <text>Channel</text>
  </widget>
  <widget type="textentry" version="3.0.0">
    <name>HistoryPV</name>
    <x>120</x>
    <y>178</y>
    <width>680</width>
    <height>30</height>
    <pv_name>ca://$(P):HistoryPV</pv_name>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Choose channel…</name>
    <x>825</x>
    <y>178</y>
    <width>190</width>
    <height>30</height>
    <text>Choose channel…</text>
    <actions>
      <action type="open_display">
        <file>archiver_channels.bob</file>
        <target>tab</target>
      </action>
    </actions>
  </widget>
  <widget type="label" version="3.0.0">
    <name>Window (hours)</name>
    <x>25</x>
    <y>225</y>
    <width>150</width>
    <height>28</height>
    <text>Window (hours)</text>
  </widget>
  <widget type="textentry" version="3.0.0">
    <name>HistoryHours</name>
    <x>180</x>
    <y>223</y>
    <width>100</width>
    <height>30</height>
    <pv_name>ca://$(P):HistoryHours</pv_name>
  </widget>
  <widget type="label" version="3.0.0">
    <name>End: hours ago</name>
    <x>310</x>
    <y>225</y>
    <width>160</width>
    <height>28</height>
    <text>End: hours ago</text>
  </widget>
  <widget type="textentry" version="3.0.0">
    <name>HistoryOffsetHours</name>
    <x>475</x>
    <y>223</y>
    <width>100</width>
    <height>30</height>
    <pv_name>ca://$(P):HistoryOffsetHours</pv_name>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Load / Refresh</name>
    <x>825</x>
    <y>223</y>
    <width>190</width>
    <height>30</height>
    <text>Load / Refresh</text>
    <actions>
      <action type="write_pv">
        <pv_name>ca://$(P):HistoryLoad</pv_name>
        <value>1</value>
      </action>
    </actions>
  </widget>
  <widget type="label" version="3.0.0">
    <name>0 hours ago ends now. History loads on request; recording continues.</name>
    <x>25</x>
    <y>265</y>
    <width>1000</width>
    <height>28</height>
    <text>0 hours ago ends now. History loads on request; recording continues.</text>
  </widget>
  <widget type="textupdate" version="3.0.0">
    <name>HistoryStatus</name>
    <x>25</x>
    <y>300</y>
    <width>1000</width>
    <height>28</height>
    <pv_name>ca://$(P):HistoryStatus</pv_name>
  </widget>
  <widget type="label" version="3.0.0">
    <name>UTC start</name>
    <x>25</x>
    <y>340</y>
    <width>100</width>
    <height>28</height>
    <text>UTC start</text>
  </widget>
  <widget type="textupdate" version="3.0.0">
    <name>HistoryStartUTC</name>
    <x>130</x>
    <y>340</y>
    <width>340</width>
    <height>28</height>
    <pv_name>ca://$(P):HistoryStartUTC</pv_name>
  </widget>
  <widget type="label" version="3.0.0">
    <name>UTC end</name>
    <x>535</x>
    <y>340</y>
    <width>100</width>
    <height>28</height>
    <text>UTC end</text>
  </widget>
  <widget type="textupdate" version="3.0.0">
    <name>HistoryEndUTC</name>
    <x>635</x>
    <y>340</y>
    <width>400</width>
    <height>28</height>
    <pv_name>ca://$(P):HistoryEndUTC</pv_name>
  </widget>
  <widget type="xyplot" version="3.0.0">
    <name>CSVHistory</name>
    <x>25</x>
    <y>385</y>
    <width>1040</width>
    <height>350</height>
    <title>Saved CSV values</title>
    <show_toolbar>true</show_toolbar>
    <x_axis>
      <title>Hours relative to window end</title>
      <autoscale>true</autoscale>
      <show_grid>true</show_grid>
    </x_axis>
    <y_axes>
      <y_axis>
        <title>Recorded value (channel units)</title>
        <autoscale>true</autoscale>
        <show_grid>true</show_grid>
      </y_axis>
    </y_axes>
    <traces>
      <trace>
        <name>History</name>
        <x_pv>ca://$(P):HistoryX</x_pv>
        <y_pv>ca://$(P):HistoryY</y_pv>
        <axis>0</axis>
        <trace_type>0</trace_type>
        <point_type>2</point_type>
        <point_size>2</point_size>
        <line_width>1</line_width>
      </trace>
    </traces>
  </widget>
  <widget type="label" version="3.0.0">
    <name>Displays up to the latest 10,000 rows in the window. Saved CSVs are unchanged.</name>
    <x>25</x>
    <y>750</y>
    <width>1000</width>
    <height>28</height>
    <text>Displays up to the latest 10,000 rows in the window. Saved CSVs are unchanged.</text>
  </widget>
</display>